<% const paginaActual = typeof pagina !== 'undefined' ? pagina : ''; %>
<% const nivelUsuario = typeof nivel !== 'undefined' ? nivel: ''; %>
<div class="navbar-block"></div>
<nav class="navbar">
  <section class="logo-navbar-section">
    <svg xmlns="http://www.w3.org/2000/svg" class="icon-navbar-logo" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-test-tube-diagonal-icon lucide-test-tube-diagonal">
      <path d="M21 7 6.82 21.18a2.83 2.83 0 0 1-3.99-.01a2.83 2.83 0 0 1 0-4L17 3" />
      <path d="m16 2 6 6" />
      <path d="M12 16H4" />
    </svg>
    <div class="texto-logo-navbar">
      <h1 class="navbar-title">Laboratorio Clínico</h1>
      <p class="navbar-subtitle">Administrador</p>
    </div>
  </section>
  <section class="todo-navbar">
    <div class="links-navbar">
      <p class="grupos-titulos">GENERAL</p>
      <a href="/" class="link-individual <%- paginaActual === 'inicio' ? 'navbar-activo' : '' -%>">
        <svg xmlns="http://www.w3.org/2000/svg" class="icons-navbar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house-icon lucide-house">
          <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8" />
          <path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
        </svg>
        <p>Inicio</p>
      </a>
      <a href="/pacientes" class="link-individual <%- paginaActual === 'pacientes' ? 'navbar-activo' : '' -%>">
        <svg xmlns="http://www.w3.org/2000/svg" class="icons-navbar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users-icon lucide-users">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
          <path d="M16 3.128a4 4 0 0 1 0 7.744" />
          <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
          <circle cx="9" cy="7" r="4" />
        </svg>
        <p>Pacientes</p>
      </a>
      <a href="/empleados" class="link-individual <%- paginaActual === 'empleados' ? 'navbar-activo' : '' -%>">
        <svg xmlns="http://www.w3.org/2000/svg" class="icons-navbar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-briefcase-icon lucide-briefcase">
          <path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
          <rect width="20" height="14" x="2" y="6" rx="2" />
        </svg>
        <p>Empleados</p>
      </a>
      <p class="grupos-titulos">LABORATORIO</p>
      <a href="/exam" class="link-individual <%- paginaActual === 'examenes' ? 'navbar-activo' : '' -%>">
        <svg xmlns="http://www.w3.org/2000/svg" class="icons-navbar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-notebook-pen-icon lucide-notebook-pen">
          <path d="M13.4 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7.4" />
          <path d="M2 6h4" />
          <path d="M2 10h4" />
          <path d="M2 14h4" />
          <path d="M2 18h4" />
          <path d="M21.378 5.626a1 1 0 1 0-3.004-3.004l-5.01 5.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z" />
        </svg>
        <p>Examenes</p>
      </a>
      <a href="/ordenes" class="link-individual <%- paginaActual === 'ordenes' ? 'navbar-activo' : '' -%>">
        <svg xmlns="http://www.w3.org/2000/svg" class="icons-navbar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-text-icon lucide-file-text">
          <path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z" />
          <path d="M14 2v5a1 1 0 0 0 1 1h5" />
          <path d="M10 9H8" />
          <path d="M16 13H8" />
          <path d="M16 17H8" />
        </svg>
        <p>Ordenes</p>
      </a>
    </div>

    <div class="user-info">
      <div class="lol">
        <p class="saludo-usuario">Logueado como </p>
        <p class="cedula-usuario"><%= nombreEmpleado + ' ' + apellidoEmpleado %></p>
      </div>

      <% if (nivel === "admin") { %>
      <a href="/usuarios">
        <svg xmlns="http://www.w3.org/2000/svg" class="icon-bottom-navbar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bolt-icon lucide-bolt">
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
          <circle cx="12" cy="12" r="4" />
        </svg>
      </a>
      <% } %>
      <a href="#info-usuario" onclick="mostrarInfoUsuario()" id="info-usuario-link">
        <svg xmlns="http://www.w3.org/2000/svg" class="icon-bottom-navbar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info-icon lucide-info">
          <circle cx="12" cy="12" r="10" />
          <path d="M12 16v-4" />
          <path d="M12 8h.01" />
        </svg>
      </a>

      <a href="/login/logout">
        <svg xmlns="http://www.w3.org/2000/svg" class="icon-bottom-navbar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-log-out-icon lucide-log-out">
          <path d="m16 17 5-5-5-5" />
          <path d="M21 12H9" />
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
        </svg>
      </a>
    </div>
  </section>
</nav>