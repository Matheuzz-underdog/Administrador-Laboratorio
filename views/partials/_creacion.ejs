<% const paginaActual = typeof pagina !== 'undefined' ? pagina : ''; %>
<div class="ventana-fondo-creacion" id="ventana-creacion">
  <div class="datos-creacion-div">
    <% if (paginaActual === 'pacientes') { %>
    <form id="form-crear" class="form-crear-dentro">
      <div class="top-info-usuario">
        <h3>Ingrese la información requerida</h3>
        <button id="cerrar-info-btn" onclick="cerrarCrear()">
          <svg xmlns="http://www.w3.org/2000/svg" class="cerrar-info-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-icon lucide-x">
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </button>
      </div>

      <div class="field">
        <label for="c-cedula">Cédula</label>
        <input type="text" id="c-cedula" placeholder="V-12345678">
      </div>

      <div class="field">
        <label for="c-nombre">Nombre</label>
        <input type="text" id="c-nombre" placeholder="John">
      </div>

      <div class="field">
        <label for="c-apellido">Apellido</label>
        <input type="text" id="c-apellido" placeholder="Doe">
      </div>

      <div class="field">
        <label for="c-sexo">Sexo</label>
        <select id="c-sexo" class="select-crear">
          <option value="">-- Seleccione --</option>
          <option value="M">Masculino</option>
          <option value="F">Femenino</option>
        </select>
      </div>

      <div class="field">
        <label for="c-fecha">Fecha de nacimiento</label>
        <input type="date" id="c-fecha">
      </div>

      <div class="field">
        <label for="c-telefono">Teléfono</label>
        <input type="text" id="c-telefono" placeholder="0412-1234567">
      </div>

      <div class="field">
        <label for="c-email">Email</label>
        <input type="email" id="c-email" placeholder="ejemplo@email.com">
      </div>

      <div class="field">
        <label for="c-direccion">Dirección</label>
        <input type="text" id="c-direccion" placeholder="Calle 1, Edificio 2">
      </div>

      <div class="btn-class">
        <button type="button" class='btn-crear' onclick="crearPaciente()">Registrar</button>
      </div>
    </form>
    <% } %>
    <% if (paginaActual === 'empleados') { %>

    <form id="post-formulario" class="form-crear-dentro">
      <div class="top-info-usuario">
        <h3>Ingrese la información requerida</h3>
        <button id="cerrar-info-btn" onclick="cerrarCrear()">
          <svg xmlns="http://www.w3.org/2000/svg" class="cerrar-info-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </button>
      </div>
      <div class="field">
        <label for="cedula-post">Cédula</label>
        <input type="text" id="cedula-post" placeholder="V-1234567">
      </div>
      <div class="field">
        <label for="nombre-post">Nombre</label>
        <input type="text" id="nombre-post" placeholder="Jhon">
      </div>
      <div class="field">
        <label for="apellido-post">Apellido</label>
        <input type="text" id="apellido-post" placeholder="Briceño">
      </div>
      <div class="field">
        <label for="cargo-post">Cargo</label>
        <input type="text" id="cargo-post" placeholder="Bionalista">
      </div>
      <div class="field">
        <label for="telefono-post">Teléfono</label>
        <input type="text" id="telefono-post" placeholder="0412-1234567">
      </div>
      <div class="field">
        <label for="correo-post">Correo</label>
        <input type="email" id="correo-post" placeholder="ejemplo@gmail.com">
      </div>
      <div class="field">
        <label for="actividad-post">Actividad</label>
        <input type="number" id="actividad-post" value="1" disabled>
      </div>
      <div class="field empleados-datos">
        <div class="container-boton-texto">
          <label>Datos Profesionales</label>
          <button type="button" class="boton-campo-profesion" onclick="crearCampoDato(0)">+</button>
        </div>
        <div id="contenedor-datos-post" class="contenedor-datos-empleados"></div>
      </div>
      <div class="btn-class">
        <button type="button" class="btn-crear" onclick="registrarEmpleado()">Registrar</button>
      </div>
    </form>

    <% } %>
    <% if (paginaActual === 'examenes') { %>
    <form id="form-crear" class="form-crear-dentro">
      <div class="top-info-usuario">
        <h3>Ingrese la información requerida</h3>
        <button id="cerrar-info-btn" onclick="cerrarCrear()">
          <svg xmlns="http://www.w3.org/2000/svg" class="cerrar-info-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </button>
      </div>
      <div class="field">
        <label for="c-nombre">Nombre</label>
        <input type="text" id="c-nombre" placeholder="Hemograma completo">
      </div>
      <div class="field">
        <label for="c-abreviatura">Abreviatura</label>
        <input type="text" id="c-abreviatura" placeholder="HEM" maxlength="4">
      </div>
      <div class="field">
        <label for="c-area">Area</label>
        <input type="text" id="c-area" placeholder="Hematologia, Quimica, etc.">
      </div>
      <div class="field">
        <label for="c-precio">Precio (Bs)</label>
        <input type="number" id="c-precio" placeholder="0.00" step="0.01" min="0">
      </div>
      <div class="field">
        <label for="c-muestra">Tipo de Muestra</label>
        <input type="text" id="c-muestra" placeholder="Sangre, Orina, etc.">
      </div>
      <div class="field">
        <label>Parametros</label>
        <button type="button" id="btn-agregar-param" title="Agregar parametro (Tecla: +)">+</button>
        <div id="contenedor-parametros"></div>
      </div>
      <div class="btn-class">
        <button type="button" class="btn-crear" onclick="crearExamen()">Registrar</button>
      </div>
    </form>
    <% } %>
    <% if (paginaActual === "ordenes") { %>
    <form id="formulario-crear-orden" class="form-crear-dentro">
      <div class="top-info-usuario">
        <h3>Ingrese la información requerida</h3>
        <button id="cerrar-info-btn" onclick="cerrarCrear()">
          <svg xmlns="http://www.w3.org/2000/svg" class="cerrar-info-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </button>
      </div>
      <div class="field">
        <label for="cedula-paciente">Cédula del paciente</label>
        <input type="text" id="cedula-paciente" pattern="^[VE]-[0-8]+$" placeholder="V-12345678">
      </div>
      <div class="field">
        <label for="cedula-empleado">Cédula del empleado</label>
        <input type="text" id="cedula-empleado" pattern="^[VE]-[0-8]+$" placeholder="V-12345678">
      </div>
      <div class="field">
        <fieldset>
          <legend>Detalles de la Orden <button type="button" id="btn-nuevo-detalle">+</button></legend>
          <div id="detalle-container"></div>
        </fieldset>
      </div>
      <div class="btn-class">
        <button type="button" id="btn-crear-orden" class="btn-crear" onclick="crearOrden()">Registrar</button>
      </div>
    </form>
    <% } %>
  </div>
</div>
<script src="/js/creacion.js"></script>