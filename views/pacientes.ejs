<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css" />
  <title>Pacientes</title>
</head>

<body>
  <%- include('partials/_navbar') %>
  <%- include('partials/_infoUsuario') %>
  <%- include('partials/_creacion') %>
  <section class="todo-container">

    <% if (datos && datos.length > 0) { %>
    <div class="todo-principal-pacientes">
      <div class="top-pacientes">
        <h3 class="title-section">Pacientes</h3>
        <label for="busqueda">
          <input type="text" id="b-cedula" class='buscador-paciente' placeholder="V-12345678">
          <button type="button" class="buscar-boton paciente" onclick="buscarPaciente()">Buscar</button>
        </label>
      </div>
      <div class="block-top"></div>
      <table class="table-general table-pacientes">
        <thead>
          <tr>
            <th>Cedula</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Sexo</th>
            <th>Fecha Nacimiento</th>
            <th>Telefono</th>
            <th>Email</th>
            <th>Direccion</th>
            <th>Fecha Registro</th>
            <% if (nivel === "admin" && "editor") { %>
            <th></th>
            <% } %>
          </tr>
        </thead>
        <tbody>
          <% datos.forEach(function(p) { %>
          <tr>
            <td><%= p.cedula_paciente %></td>
            <td><%= p.nombre_paciente %></td>
            <td><%= p.apellido_paciente %></td>
            <td><%= p.sexo_paciente %></td>
            <td><%= p.fecha_nacimiento ? new Date(p.fecha_nacimiento).toLocaleDateString('es-VE') : '-' %></td>
            <td><%= p.telefono_paciente || '-' %></td>
            <td><%= p.email_paciente || '-' %></td>
            <td><%= p.direccion_paciente || '-' %></td>
            <td><%= p.fecha_registro ? new Date(p.fecha_registro).toLocaleString('es-VE') : '-' %></td>
            <% if (nivel === "editor" || nivel === "admin") { %>
            <td class="acciones-td">
              <button class="boton-accion-tabla editar" onclick="editarPacienteAbrir('editar', '<%= p.cedula_paciente%>')">
                <svg xmlns="http://www.w3.org/2000/svg" class="acciones-btn-svg editar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-pen-icon lucide-square-pen">
                  <path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                  <path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z" />
                </svg>
              </button>
              <% } if (nivel === "admin") { %>
              <button class="boton-accion-tabla editar" onclick="editarPacienteAbrir('editar', '<%= p.cedula_paciente%>')">
                <svg xmlns="http://www.w3.org/2000/svg" class="acciones-btn-svg editar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash-icon lucide-trash">
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />
                  <path d="M3 6h18" />
                  <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                </svg>
              </button>
            </td>
            <% } else if (nivel === "editor") { %>
            </td>
            <% } %>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } else { %>
      <p>No hay datos registrados.</p>
      <% } %>
    </div>
    <div class="area-admin-editor">
      <button class="area-admin-editor-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus-icon lucide-plus">
          <path d="M5 12h14" />
          <path d="M12 5v14" />
        </svg>
      </button>
    </div>

    <div class="window-crear-paciente" id="window-crear-paciente">

      <form id="form-crear" class="form-crear-paciente">
        <div class="top-info-usuario">
          <h3>Ingrese la información requerida</h3>
          <button id="cerrar-info-btn" onclick="cerrarCrearPaciente()">
            <svg xmlns="http://www.w3.org/2000/svg" class="cerrar-info-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-icon lucide-x">
              <path d="M18 6 6 18" />
              <path d="m6 6 12 12" />
            </svg>
          </button>
        </div>

        <div class="field">
          <label for="c-cedula">Cédula</label>
          <input type="text" id="c-cedula" placeholder="V-12345678">
        </div>

        <div class="field">
          <label for="c-nombre">Nombre</label>
          <input type="text" id="c-nombre">
        </div>

        <div class="field">
          <label for="c-apellido">Apellido</label>
          <input type="text" id="c-apellido">
        </div>

        <div class="field">
          <label for="c-sexo">Sexo</label>
          <select id="c-sexo">
            <option value="">-- Seleccione --</option>
            <option value="M">Masculino</option>
            <option value="F">Femenino</option>
          </select>
        </div>

        <div class="field">
          <label for="c-fecha">Fecha de nacimiento</label>
          <input type="date" id="c-fecha">
        </div>

        <div class="field">
          <label for="c-telefono">Teléfono</label>
          <input type="text" id="c-telefono" placeholder="0412-1234567">
        </div>

        <div class="field">
          <label for="c-email">Email <span class="opcional">(opcional)</span></label>
          <input type="email" id="c-email">
        </div>

        <div class="field">
          <label for="c-direccion">Dirección</label>
          <input type="text" id="c-direccion">
        </div>

        <button type="button" onclick="crearPaciente()">Registrar paciente</button>

      </form>
    </div>

