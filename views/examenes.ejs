<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css" />
  <title>Gestion de Examenes</title>
</head>
<body>
  <%- include('partials/_header') %>

  <h1>Gestion de Examenes</h1>
  <hr>

  <div id="modal-fondo" onclick="cerrarModal()" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background-color:rgba(0,0,0,0.45);">
    <div onclick="event.stopPropagation()" style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); background:white; border:2px solid black; padding:30px 40px; min-width:280px; max-width:420px; text-align:center;">
      <p id="texto-modal" style="font-size:1.1em; margin:0 0 18px 0;"></p>
      <small>click para cerrar</small>
    </div>
  </div>

  <h2>Lista de Examenes</h2>

  <% if (examenes && examenes.length > 0) { %>
    <table border="1" cellpadding="6" cellspacing="0">
      <thead>
        <tr>
          <th>ID</th>
          <th>Nombre</th>
          <th>Abreviatura</th>
          <th>Area</th>
          <th>Precio</th>
          <th>Tipo de Muestra</th>
          <th>Parametros</th>
        </tr>
      </thead>
      <tbody>
        <% for (var i = 0; i < examenes.length; i++) { %>
          <% var e = examenes[i]; %>
          <% var params = []; %>
          <% try { params = JSON.parse(e.parametros); } catch(ex) { params = []; } %>
          <% if (!Array.isArray(params)) { params = []; } %>
          <tr>
            <td><%= e.id_examen %></td>
            <td><%= e.nombre_examen %></td>
            <td><%= e.abreviatura_examen %></td>
            <td><%= e.area_examen %></td>
            <td><%= e.precio_examen %></td>
            <td><%= e.tipo_muestra %></td>
            <td>
              <% if (params.length > 0) { %>
                <ul style="margin:0; padding-left:18px;">
                  <% for (var j = 0; j < params.length; j++) { %>
                    <li>
                      <strong><%= params[j].nombre %></strong>
                      <% if (params[j].unidad) { %> (<%= params[j].unidad %>)<% } %>
                      <% if (params[j].referencia) { %> &mdash; Ref: <%= params[j].referencia %><% } %>
                    </li>
                  <% } %>
                </ul>
              <% } else { %>
                <em>Sin parametros</em>
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  <% } else { %>
    <p>No hay examenes registrados.</p>
  <% } %>

  <hr>

  <h2>Registrar Examen</h2>

  <form id="form-crear">
    <table>
      <tr>
        <td><label for="c-nombre">Nombre:</label></td>
        <td><input type="text" id="c-nombre" placeholder="Hemograma completo"></td>
      </tr>
      <tr>
        <td><label for="c-abreviatura">Abreviatura:</label></td>
        <td><input type="text" id="c-abreviatura" placeholder="HEM" maxlength="3"></td>
      </tr>
      <tr>
        <td><label for="c-area">Area:</label></td>
        <td><input type="text" id="c-area" placeholder="Hematologia, Quimica, etc."></td>
      </tr>
      <tr>
        <td><label for="c-precio">Precio (Bs):</label></td>
        <td><input type="number" id="c-precio" placeholder="0.00" step="0.01" min="0"></td>
      </tr>
      <tr>
        <td><label for="c-muestra">Tipo de Muestra:</label></td>
        <td><input type="text" id="c-muestra" placeholder="Sangre, Orina, etc."></td>
      </tr>
    </table>

    <br>

    <fieldset>
      <legend>Parametros &nbsp;<button type="button" id="btn-agregar-param" title="Agregar parametro (Tecla: +)">+</button></legend>
      <div id="contenedor-parametros"></div>
      <small>Nombre es obligatorio. Unidad y Referencia son opcionales.</small>
    </fieldset>

    <br>
    <button type="button" onclick="crearExamen()">Registrar</button>
  </form>

  <hr>

  <h2>Buscar Examen</h2>

  <label for="b-abreviatura">Abreviatura:</label>
  <input type="text" id="b-abreviatura" placeholder="HEM, GLU, etc.">
  <button type="button" onclick="buscarExamen()">Buscar</button>

  <div id="resultado-busqueda"></div>

  <hr>

  <h2>Eliminar Examen</h2>

  <label for="e-abreviatura">Abreviatura:</label>
  <input type="text" id="e-abreviatura" placeholder="HEM, GLU, etc.">
  <button type="button" onclick="eliminarExamen()">Eliminar</button>

  <hr>

  <script src="/js/examenes.js"></script>

</body>
</html>