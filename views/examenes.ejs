<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css" />
  <title>Examenes</title>
</head>

<body>
  <%- include('partials/_navbar') %>
  <%- include('partials/_infoUsuario') %>
  <%- include('partials/_confirmacion') %>
  <%- include('partials/_creacion') %>

  <section class="todo-container">

    <% if (examenes && examenes.length > 0) { %>
    <div class="todo-principal-pacientes">
      <div class="top-pacientes">
        <span>
          <h3 class="title-section">Examenes</h3>
          <% if (nivel === "admin" && "editor") { %>
          <button class="area-admin-editor-btn" onclick="abrirCrear()">
            Registrar nuevo examen
          </button>
          <% } %>
        </span>
        <label for="busqueda" class="busqueda-label">
          <button id="btn-reset-buscar" class="btn-reseteo" onclick="window.location.reload()">
            <svg xmlns="http://www.w3.org/2000/svg" class="btn-reseteo-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw-icon lucide-rotate-ccw">
              <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
              <path d="M3 3v5h5" />
            </svg>
          </button>
          <input type="text" id="b-abreviatura" class="buscador-paciente" placeholder="HEM, GLU, etc." maxlength="4">
          <button type="button" class="buscar-boton paciente" onclick="buscarExamen()">Buscar</button>
        </label>
      </div>
      <div class="block-top"></div>
      <table class="table-general table-pacientes">
        <thead>
          <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Abreviatura</th>
            <th>Area</th>
            <th>Precio</th>
            <th>Tipo de Muestra</th>
            <th>Parametros</th>
            <% if (nivel === "admin" && "editor") { %>
            <th></th>
            <% } %>
          </tr>
        </thead>
        <tbody id="tbody-table">
          <% for (var i = 0; i < examenes.length; i++) { %>
          <% var e = examenes[i]; %>
          <% var params = Array.isArray(e.parametros) ? e.parametros : []; %>
          <tr>
            <td><%= e.id_examen %></td>
            <td><%= e.nombre_examen %></td>
            <td><%= e.abreviatura_examen %></td>
            <td><%= e.area_examen %></td>
            <td><%= e.precio_examen %></td>
            <td><%= e.tipo_muestra %></td>
            <td>
              <% if (params.length > 0) { %>
              <ul class="lista-parametros">
                <% for (var j = 0; j < params.length; j++) { %>
                <li>
                  <strong><%= params[j].nombre %></strong>
                  <% if (params[j].unidad) { %>(<%= params[j].unidad %>)<% } %>
                  <% if (params[j].referencia) { %>&mdash; Ref: <%= params[j].referencia %><% } %>
                </li>
                <% } %>
              </ul>
              <% } else { %>
              <em>Sin parametros</em>
              <% } %>
            </td>
            <% if (nivel === "admin") { %>
            <td>
              <button class="boton-accion-tabla borrar" onclick="eliminarExamen('<%= e.abreviatura_examen %>')">
                <svg xmlns="http://www.w3.org/2000/svg" class="acciones-btn-svg editar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash-icon lucide-trash">
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />
                  <path d="M3 6h18" />
                  <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                </svg>
              </button>
            </td>
            <% } else if (nivel === "editor") { %>
            </td>
            <% } %>
          </tr>
          <% } %>
        </tbody>
      </table>
      <% } else { %>
      <p>No hay datos registrados.</p>
      <% } %>
    </div>

  </section>

  <script src="/js/examenes.js"></script>
  <script src="/js/navbar.js"></script>

</body>

</html>