<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <link rel="stylesheet" href="/css/login.css" />
  <title>Login — Sistema de Laboratorio</title>
</head>

<body>
  <div class="todo-container">
    <h2 class="titulo-login">Sistema de Gestión de Laboratorio</h2>

    <h3 class="iniciar-sesion-texto">Iniciar Sesión</h3>

    <% if (typeof error !== 'undefined') { %>
    <p><strong>Error:</strong> <%= error %></p>
    <% } %>

    <form method="POST" action="/login">
      <label for="cedula">
        <input type="text" id="cedula" name="cedula" placeholder="cedula" required></label>

      <label for="password">
        <input type="password" id="password" placeholder="contraseña" name="password" required></label>

      <span class="idk"><button type="submit">Entrar</button></span>
    </form>
  </div>
</body>

</html>