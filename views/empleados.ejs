<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css" />
  <title>Empleados</title>
</head>

<body>
  <%- include('partials/_navbar') %>
  <%- include('partials/_infoUsuario') %>
  <%- include('partials/_confirmacion') %>
  <%- include('partials/_creacion') %>
  <%- include('partials/_editar') %>

  <section class="todo-container">

    <% if (empleados && empleados.length > 0) { %>
    <div class="todo-principal-pacientes">
      <div class="top-pacientes">
        <span>
          <h3 class="title-section">Empleados</h3>
          <% if (nivel === "admin" && "editor") { %>
          <button class="area-admin-editor-btn" onclick="abrirCrear()">
            Registrar nuevo empleado
          </button>
          <% } %>
        </span>
        <label for="busqueda" class="busqueda-label">
          <button id="btn-reset-buscar" class="btn-reseteo" onclick="window.location.reload()">
            <svg xmlns="http://www.w3.org/2000/svg" class="btn-reseteo-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw-icon lucide-rotate-ccw">
              <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
              <path d="M3 3v5h5" />
            </svg>
          </button>
          <input type="text" id="cedula-get" class='buscador-paciente' pattern="^[VE]-[0-8]+$" placeholder="V-12345678">
          <button type="button" class="buscar-boton paciente" onclick="buscarEmpleado('<%= nivel %>')">Buscar</button>
        </label>
      </div>
      <div class="block-top"></div>
      <table class="table-general table-pacientes">
        <thead>
          <tr>
            <th>Cedula</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Cargo</th>
            <th>Telefono</th>
            <th>Correo</th>
            <th>Actividad</th>
            <th>Datos Profesionales</th>
            <% if (nivel === "admin" && "editor") { %>
            <th></th>
            <% } %>
          </tr>
        </thead>
        <tbody id="tbody-table">
          <% empleados.forEach(function(e) { %>
          <tr>
            <td><%= e.cedula_empleado %></td>
            <td><%= e.nombre_empleado %></td>
            <td><%= e.apellido_empleado %></td>
            <td><%= e.cargo_empleado || '-' %></td>
            <td><%= e.telefono_empleado || '-' %></td>
            <td><%= e.email_empleado || '-' %></td>
            <td class="actividad-empleado-td">
              <%
                let actividad; 
                if (e.actividad_empleado === 1) {
                  actividad = "Activo";
                } else {
                  actividad = "Inactivo";
                }
              %>
              <%= actividad %>
              <% if (nivel === "editor" || nivel === "admin") { %>
              <button onclick="cambiarEstado('<%= e.cedula_empleado %>','<%= e.actividad_empleado %>')" class="boton-cambiar">
                <svg xmlns="http://www.w3.org/2000/svg" class="boton-cambiar-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-ccw-icon lucide-refresh-ccw">
                  <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
                  <path d="M3 3v5h5" />
                  <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16" />
                  <path d="M16 16h5v5" />
                </svg>
              </button>
              <% } %>
            </td>
            <td>
              <%
                let dp = e.datos_profesionales;
                if (typeof dp === "string") { try { dp = JSON.parse(dp); } catch(err) { dp = null; } }
              %>
              <% if (dp && typeof dp === "object" && Object.keys(dp).length > 0) { %>
              <ul class="lista-parametros">
                <% Object.entries(dp).forEach(([clave, valor]) => { %>
                <li><strong><%= clave %></strong> &mdash; <%= valor %></li>
                <% }) %>
              </ul>
              <% } else { %>
              <em>Sin datos profesionales</em>
              <% } %>
              </td>
              <% if (nivel === "editor" || nivel === "admin") { %>
              <td class="acciones-td">
                <button class="boton-accion-tabla editar" onclick="editarEmpleado('<%= e.cedula_empleado%>')">
                  <svg xmlns="http://www.w3.org/2000/svg" class="acciones-btn-svg editar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-pen-icon lucide-square-pen">
                    <path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                    <path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z" />
                  </svg>
                </button>
                <% } if (nivel === "admin") { %>
                <button class="boton-accion-tabla borrar" onclick="eliminarEmpleado('<%= e.cedula_empleado%>')">
                  <svg xmlns="http://www.w3.org/2000/svg" class="acciones-btn-svg editar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash-icon lucide-trash">
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />
                    <path d="M3 6h18" />
                    <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                  </svg>
                </button>
              </td>
              <% } else if (nivel === "editor") { %>
              </td>
              <% } %>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } else { %>
      <p>No hay datos registrados.</p>
      <% } %>
    </div>

  </section>

  <script src="/js/empleados.js"></script>
  <script src="/js/navbar.js"></script>

</body>

</html>